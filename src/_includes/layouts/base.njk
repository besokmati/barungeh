---
ogType: website
---

{% set metaDescription = description or excerpt or lead or "Cerita, riddle, misteri, dan kisah horror yang baru terasa aneh setelah lo sadar ada sesuatu yang salah." %}

{% if ogImage %}
  {% set socialImage = ogImage | absoluteUrl %}
{% else %}
  {% set socialImage = site.ogImage %}
{% endif %}

<!doctype html>
<html lang="id">

<head>

  <meta charset="utf-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1"
  >


  {# ======================================================
     TITLE + DESCRIPTION
     ====================================================== #}

  <title>
    {{ title }}{% if title != "BARU NGEH" %} — BARU NGEH{% endif %}
  </title>

  <meta
    name="description"
    content="{{ metaDescription | escape }}"
  >


  {# ======================================================
     CANONICAL + INDEXING
     ====================================================== #}

  <link
    rel="canonical"
    href="{{ site.url }}{{ page.url }}"
  >

  {% if noindex %}

    <meta
      name="robots"
      content="noindex,nofollow"
    >

  {% else %}

    <meta
      name="robots"
      content="index,follow"
    >

  {% endif %}


  {# ======================================================
     ICONS
     ====================================================== #}

  <link
    rel="icon"
    href="/assets/favicon.ico"
    sizes="any"
  >

  <link
    rel="icon"
    type="image/png"
    href="/assets/favicon.png"
  >

  <link
    rel="apple-touch-icon"
    href="/assets/apple-touch-icon.png"
  >

  <meta
    name="theme-color"
    content="#080808"
  >


  {# ======================================================
     FONT
     ====================================================== #}

  <link
    rel="preconnect"
    href="https://fonts.googleapis.com"
  >

  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  >

  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400..800&display=swap"
  >


  {# ======================================================
     OPEN GRAPH
     Facebook / WhatsApp / Messenger / Discord
     ====================================================== #}

  <meta
    property="og:type"
    content="{{ ogType }}"
  >

  <meta
    property="og:site_name"
    content="BARU NGEH"
  >

  <meta
    property="og:locale"
    content="id_ID"
  >

  <meta
    property="og:title"
    content="{{ title | escape }}"
  >

  <meta
    property="og:description"
    content="{{ metaDescription | escape }}"
  >

  <meta
    property="og:url"
    content="{{ site.url }}{{ page.url }}"
  >

  <meta
    property="og:image"
    content="{{ socialImage }}"
  >

  <meta
    property="og:image:secure_url"
    content="{{ socialImage }}"
  >

  <meta
    property="og:image:width"
    content="1200"
  >

  <meta
    property="og:image:height"
    content="630"
  >

  <meta
    property="og:image:alt"
    content="{{ title | escape }} — BARU NGEH"
  >


  {# ======================================================
     TWITTER / X
     ====================================================== #}

  <meta
    name="twitter:card"
    content="summary_large_image"
  >

  <meta
    name="twitter:title"
    content="{{ title | escape }}"
  >

  <meta
    name="twitter:description"
    content="{{ metaDescription | escape }}"
  >

  <meta
    name="twitter:image"
    content="{{ socialImage }}"
  >


  {# ======================================================
     STRUCTURED DATA — HOMEPAGE
     ====================================================== #}

  {% if page.url == "/" %}

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "BARU NGEH",
    "url": "{{ site.url }}/",
    "inLanguage": "id-ID"
  }
  </script>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "BARU NGEH",
    "url": "{{ site.url }}/",
    "logo": "{{ site.logo }}",
    "sameAs": [
      "{{ site.fb }}"
    ]
  }
  </script>

  {% endif %}


  {# ======================================================
     STRUCTURED DATA — ARTICLE
     Riddle dan Cerita
     ====================================================== #}

  {% if ogType == "article" %}

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "{{ title | escape }}",
    "description": "{{ metaDescription | escape }}",
    "image": "{{ socialImage }}",
    "inLanguage": "id-ID",
    "datePublished": "{{ page.date | dateISO }}",

    "author": {
      "@type": "Organization",
      "name": "BARU NGEH"
    },

    "publisher": {
      "@type": "Organization",
      "name": "BARU NGEH",
      "logo": {
        "@type": "ImageObject",
        "url": "{{ site.logo }}"
      }
    },

    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": "{{ site.url }}{{ page.url }}"
    }
  }
  </script>

  {% endif %}


  {# ======================================================
     CSS
     ====================================================== #}

  <link
    rel="stylesheet"
    href="/assets/styles.css"
  >

</head>


<body>


  {# ======================================================
     HEADER
     ====================================================== #}

  <header class="header">

    <div class="container nav">

      <a
        class="brand"
        href="/"
        aria-label="BARU NGEH"
      >

        <span class="brand-eye"></span>

        <span>
          BARU NGEH
        </span>

      </a>


      <button
        class="menu"
        aria-label="Buka menu"
      >
        ☰
      </button>


      <nav class="navlinks">

        <a href="/">
          Home
        </a>

        <a href="/riddle/">
          Riddle
        </a>

        <a href="/cerita/">
          Cerita
        </a>

        <a href="/video/">
          Video
        </a>

        <a href="/#tentang">
          Tentang
        </a>

        <a
          class="nav-cta"
          href="/submit/"
        >
          Submit Cerita
        </a>

      </nav>

    </div>

  </header>


  {# ======================================================
     MAIN CONTENT
     ====================================================== #}

  <main class="container">

    {{ content | safe }}

  </main>


  {# ======================================================
     FOOTER
     ====================================================== #}

  <footer class="footer">

    <div class="container copyright">

      <span>
        © 2026 BARU NGEH
      </span>

      <span class="foot-links">

        <a href="/kebijakan-privasi/">
          Kebijakan Privasi
        </a>

        <a
          data-fb
          href="#"
        >
          Facebook
        </a>

      </span>

    </div>

  </footer>


  <script src="/assets/app.js"></script>

</body>

</html>

---
ogType: website
---
<!doctype html><html lang="id"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ title }}{% if title != "BARU NGEH" %} — BARU NGEH{% endif %}</title>
<meta name="description" content="{{ description }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
{% if noindex %}<meta name="robots" content="noindex,nofollow">{% endif %}
<link rel="icon" href="/assets/favicon.ico" sizes="any">
<link rel="icon" type="image/png" href="/assets/favicon.png">
<link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
<meta name="theme-color" content="#080808">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400..800&display=swap">
<meta property="og:type" content="{{ ogType }}">
<meta property="og:site_name" content="BARU NGEH">
<meta property="og:locale" content="id_ID">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ ogImage or site.ogImage }}">
<meta property="og:image:width" content="1200"><meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title }}">
<meta name="twitter:description" content="{{ description }}">
<meta name="twitter:image" content="{{ ogImage or site.ogImage }}">
{% if page.url == "/" %}<script type="application/ld+json">{"@context":"https://schema.org","@type":"WebSite","name":"BARU NGEH","url":"{{ site.url }}/","inLanguage":"id-ID"}</script>
<script type="application/ld+json">{"@context":"https://schema.org","@type":"Organization","name":"BARU NGEH","url":"{{ site.url }}/","logo":"{{ site.logo }}","sameAs":["{{ site.fb }}"]}</script>{% endif %}
{% if ogType == "article" %}<script type="application/ld+json">{"@context":"https://schema.org","@type":"Article","headline":"{{ title }}","description":"{{ description }}","image":"{{ ogImage or site.ogImage }}","inLanguage":"id-ID","datePublished":"{{ page.date | dateISO }}","author":{"@type":"Organization","name":"BARU NGEH"},"publisher":{"@type":"Organization","name":"BARU NGEH","logo":{"@type":"ImageObject","url":"{{ site.logo }}"}},"mainEntityOfPage":"{{ site.url }}{{ page.url }}"}</script>{% endif %}
<link rel="stylesheet" href="/assets/styles.css"></head><body>
<header class="header"><div class="container nav"><a class="brand" href="/"><span class="brand-eye"></span><span>BARU NGEH</span></a><button class="menu" aria-label="Buka menu">☰</button><nav class="navlinks"><a href="/">Home</a><a href="/riddle/">Riddle</a><a href="/cerita/">Cerita</a><a href="/video/">Video</a><a href="/#tentang">Tentang</a><a class="nav-cta" href="/submit/">Submit Cerita</a></nav></div></header>
<main class="container">{{ content | safe }}</main>
<footer class="footer"><div class="container copyright"><span>© 2026 BARU NGEH</span><span class="foot-links"><a href="/kebijakan-privasi/">Kebijakan Privasi</a><a data-fb href="#">Facebook</a></span></div></footer>
<script src="/assets/app.js"></script></body></html>
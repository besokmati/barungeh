---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- set staticPages = ["/","/riddle/","/cerita/","/video/","/submit/","/kebijakan-privasi/"] %}
{%- for u in staticPages %}<url><loc>{{ site.url }}{{ u }}</loc></url>
{%- endfor %}
{%- for p in collections.riddlePub %}<url><loc>{{ site.url }}{{ p.url }}</loc><lastmod>{{ p.date | dateISO }}</lastmod></url>
{%- endfor %}
{%- for p in collections.ceritaPub %}<url><loc>{{ site.url }}{{ p.url }}</loc><lastmod>{{ p.date | dateISO }}</lastmod></url>
{%- endfor %}
</urlset>